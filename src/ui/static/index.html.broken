                                    snapshot: { dataset: 'crypto_daily', calendar: 'crypto_daily', result: '', status: '' },
                                    features: { dataset_ref: 'crypto_daily', handler: 'Alpha158', params: '', result: '', status: '' },
                                    train: { dataset_ref: 'crypto_daily', feature_set_ref: 'alpha158', handler: 'LGBModel', params: '', result: '', status: '' },
                                    experiment: { dataset: 'crypto_daily', recipe: 'lightgbm_alpha158', costs: 'medium', rebalance: 'weekly', result: '', status: '' },
                                    backtest: { model_id: '', dataset_ref: 'crypto_daily', costs: 'medium', rebalance: 'weekly', result: '', status: '' },
                                    predict: { model_id: '', dataset_ref: 'crypto_daily', result: '', status: '' },
                                    schedule: { job: 'daily_prediction', rrule: 'FREQ=DAILY;BYHOUR=9', params: '{}', result: '', status: '' },
                                    notification: { template_id: 'prediction_alert', channels: [], result: '', status: '' },
