                        var(--danger)4px;
                        font-size: 14px13pxvar(--text-secondary)/* Quick Actions */
                    quickactionsdisplayflexgap12pxbottom24px        .quick-action {
                        flex: 1;
                        padding: 16px;
                        background: var(--bg-secondary);
                        border: 1px solid var(--border-color);
                        border-radius: 12px;
            all;
                        text-align: centerquick-actionborder-colorvar(--accent-primary);
                        transform: translateY(-2px)quickaction-iconfont-size24pxmargin-bottom8pxquickactionlabelfont-size13px;
                        font-weight: 500/* Responsive */
                    @media (maxwidth: 1400px).main-layout {
                            grid-template-columns280px 1fr}
                        .activitypanel {
                            displaynone
                        }@media (maxwidth: 768px).main-layout {
                            grid-template-columns1fr
                        sidebar
                            displaynone
                        }app-            <header class="header">
                            <div class="header-left">
                                <div class="logo">
                                    <div class="logo-icon">⚡</div>
                                    <span>Qlib Trading</span>
                                <nav class="nav-tabs">
                                    <button
                                        v-for="tab in tabs"
                                        :key="tab.id"
                                        :class="['nav-tab', { active: activeTab === tab.id }]"
                                        @click="activeTab = tab.id"
                                    >
                                        {{ tab.name }}
                                    </button>
                                </nav>
                            </div>
                            <div class="header-right">
                                <div class="status-indicator">
                                    <div :class="['status-dot', { disconnected: !connected }]"></div>
                                    <span>{{ connected ? 'Connected' : 'Disconnected' }}</span>
                                </div>
                            </div>
                        </header>

                        <!-- Main Layout -->
                        <div class="main-layout">
                            <!-- Sidebar -->
                            <aside class="sidebar">
                                <div class="sidebar-section">
                                    <div class="sidebar-title">Quick Actions</div>
                                    <div
                                        v-for="action in quickActions"
                                        :key="action.id"
                                        :class="['sidebar-item', { active: activeView === action.id }]"
                                        @click="activeView = action.id"
                                    >
                                        <span class="sidebar-icon">{{ action.icon }}</span>
                                        <span>{{ action.name }}</span>
                                    </div>
                                </div>
                                <div class="sidebar-section">
                                    <div class="sidebar-title">Tools</div>
                                    <div
                                        v-for="tool in toolCategories"
                                        :key="tool.id"
                                        :class="['sidebar-item', { active: activeView === tool.id }]"
                                        @click="activeView = tool.id"
                                    >
                                        <span class="sidebar-icon">{{ tool.icon }}</span>
                                        <span>{{ tool.name }}</span>
                                    </div>
                                </div>
                            </aside>

                            <!-- Main Content -->
                            <main class="main-content">
                                <!-- Dashboard View -->
                                <div v-if="activeView === 'dashboard'">
                                    <div class="dashboard-header">
                                        <h1 class="page-title">Dashboard</h1>
                                        <p class="page-subtitle">Overview of your trading platform</p>
                                    </div>

                                    <div class="stats-grid">
                                        <div class="stat-card">
                                            <div class="stat-label">Models Trained</div>
                                            <div class="stat-value">{{ stats.models }}</div>
                                            <div class="stat-change positive">↑ 12% this week</div>
                                        </div>
                                        <div class="stat-card">
                                            <div class="stat-label">Active Backtests</div>
                                            <div class="stat-value">{{ stats.backtests }}</div>
                                            <div class="stat-change">Running</div>
                                        </div>
                                        <div class="stat-card">
                                            <div class="stat-label">Predictions</div>
                                            <div class="stat-value">{{ stats.predictions }}</div>
                                            <div class="stat-change positive">↑ 28% today</div>
                                        </div>
                                        <div class="stat-card">
                                            <div class="stat-label">WebSocket Clients</div>
                                            <div class="stat-value">{{ stats.websocket_clients }}</div>
                                            <div class="stat-change">{{ connected ? 'Active' : 'Inactive' }}</div>
                                        </div>
                                    </div>

                                    <div class="quick-actions">
                                        <div class="quick-action" @click="activeView = 'data'">
                                            <div class="quick-action-icon">📊</div>
                                            <div class="quick-action-label">Get Market Data</div>
                                        </div>
                                        <div class="quick-action" @click="activeView = 'models'">
                                            <div class="quick-action-icon">🤖</div>
                                            <div class="quick-action-label">Train Model</div>
                                        </div>
                                        <div class="quick-action" @click="activeView = 'backtest'">
                                            <div class="quick-action-icon">📈</div>
                                            <div class="quick-action-label">Run Backtest</div>
                                        </div>
                                        <div class="quick-action" @click="activeView = 'serving'">
                                            <div class="quick-action-icon">🔮</div>
                                            <div class="quick-action-label">Generate Predictions</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Tools View -->
                                <div v-if="activeView === 'data'" class="tools-container">
                                    <div class="dashboard-header">
                                        <h1 class="page-title">Market Data</h1>
                                        <p class="page-subtitle">Access real-time and historical crypto market data</p>
                                    </div>

                                    <div class="tools-grid">
                                        <div class="tool-card">
                                            <div class="tool-header">
                                                <div>
                                                    <div class="tool-title">Real-Time Quote</div>
                                                    <div class="tool-description">Get live market quote for any crypto pair</div>
                                                </div>
                                                <div class="tool-badge">CCXT</div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Symbol</label>
                                                <input v-model="forms.quote.symbol" class="form-input" placeholder="BTC/USDT">
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Exchange</label>
                                                <select v-model="forms.quote.provider" class="form-select">
                                                    <option value="">Auto-select</option>
                                                    <option value="binance">Binance</option>
                                                    <option value="kraken">Kraken</option>
                                                    <option value="coinbase">Coinbase</option>
                                                </select>
                                            </div>
                                            <button @click="getQuote" class="btn btn-primary" :disabled="loading">
                                                <span v-if="!loading">Get Quote</span>
                                                <span v-else><span class="spinner"></span> Loading...</span>
                                            </button>
                                            <div v-if="forms.quote.result" :class="['result-box', forms.quote.status]">{{ forms.quote.result }}</div>
                                        </div>

                                        <div class="tool-card">
                                            <div class="tool-header">
                                                <div>
                                                    <div class="tool-title">Historical Data</div>
                                                    <div class="tool-description">Download OHLCV historical price data</div>
                                                </div>
                                                <div class="tool-badge">CCXT</div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Symbol</label>
                                                <input v-model="forms.historical.symbol" class="form-input" placeholder="BTC/USDT">
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Date Range</label>
                                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                                    <input v-model="forms.historical.start_date" type="date" class="form-input">
                                                    <input v-model="forms.historical.end_date" type="date" class="form-input">
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Interval</label>
                                                <select v-model="forms.historical.interval" class="form-select">
                                                    <option value="1m">1 Minute</option>
                                                    <option value="5m">5 Minutes</option>
                                                    <option value="1h">1 Hour</option>
                                                    <option value="1d">1 Day</option>
                                                </select>
                                            </div>
                                            <button @click="getHistorical" class="btn btn-primary" :disabled="loading">
                                                <span v-if="!loading">Download Data</span>
                                                <span v-else><span class="spinner"></span> Loading...</span>
                                            </button>
                                            <div v-if="forms.historical.result" :class="['result-box', forms.historical.status]">{{ forms.historical.result }}</div>
                                        </div>

                                        <div class="tool-card">
                                            <div class="tool-header">
                                                <div>
                                                    <div class="tool-title">Create Snapshot</div>
                                                    <div class="tool-description">Build point-in-time dataset snapshot</div>
                                                </div>
                                                <div class="tool-badge">Qlib</div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Dataset Name</label>
                                                <input v-model="forms.snapshot.dataset" class="form-input" placeholder="crypto_daily">
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Calendar Type</label>
                                                <select v-model="forms.snapshot.calendar" class="form-select">
                                                    <option value="crypto_daily">Crypto Daily (24/7)</option>
                                                    <option value="crypto_hourly">Crypto Hourly (24/7)</option>
                                                </select>
                                            </div>
                                            <button @click="createSnapshot" class="btn btn-primary" :disabled="loading">
                                                <span v-if="!loading">Create Snapshot</span>
                                                <span v-else><span class="spinner"></span> Processing...</span>
                                            </button>
                                            <div v-if="forms.snapshot.result" :class="['result-box', forms.snapshot.status]">{{ forms.snapshot.result }}</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Features View -->
                                <div v-if="activeView === 'features'" class="tools-container">
                                    <div class="dashboard-header">
                                        <h1 class="page-title">Feature Engineering</h1>
                                        <p class="page-subtitle">Create Alpha158, Alpha360, or custom feature sets</p>
                                    </div>

                                    <div class="tools-grid">
                                        <div class="tool-card">
                                            <div class="tool-header">
                                                <div>
                                                    <div class="tool-title">Feature Set Builder</div>
                                                    <div class="tool-description">Generate quantitative features for model training</div>
                                                </div>
                                                <div class="tool-badge">Qlib</div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Dataset Reference</label>
                                                <input v-model="forms.features.dataset_ref" class="form-input" placeholder="crypto_daily">
