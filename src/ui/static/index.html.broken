    getQuoteawaitthiscallAPI'/api/market/quote', { symbol:
    this.forms.quote.symbol, provider: this.forms.quote.provider || null },
    'quote' async getHistorical() { await this.callAPI('/api/market/historical',
    { symbol: this.forms.historical.symbol, start_date:
    this.forms.historical.start_date, end_date: this.forms.historical.end_date,
    interval: this.forms.historical.interval }, 'historical'); }, async
    createSnapshot() { await this.callAPI('/api/data/snapshot', { dataset:
    this.forms.snapshot.dataset, calendar: this.forms.snapshot.calendar },
    'snapshot'); }, async createFeatures() { const params =
    this.forms.features.params ? JSON.parse(this.forms.features.params) : {};
    await this.callAPI('/api/features/create', { dataset_ref:
    this.forms.features.dataset_ref, handler: this.forms.features.handler,
    params }, 'features'); }, async trainModel() { const params =
    this.forms.train.params ? JSON.parse(this.forms.train.params) : {}; await
    this.callAPI('/api/models/train', { dataset_ref:
    this.forms.train.dataset_ref, feature_set_ref:
    this.forms.train.feature_set_ref, handler: this.forms.train.handler, params
    }, 'train'); }, async runExperiment() { await
    this.callAPI('/api/experiments/run', { dataset:
    this.forms.experiment.dataset, recipe: this.forms.experiment.recipe, costs:
    this.forms.experiment.costs, rebalance: this.forms.experiment.rebalance },
    'experiment'); }, async runBacktest() { await
    this.callAPI('/api/backtests/run', { model_id: this.forms.backtest.model_id,
    dataset_ref: this.forms.backtest.dataset_ref, costs:
    this.forms.backtest.costs, rebalance: this.forms.backtest.rebalance },
    'backtest'); }, async predictToday() { await
    this.callAPI('/api/serving/predict', { model_id:
    this.forms.predict.model_id, dataset_ref: this.forms.predict.dataset_ref },
    'predict'); }, async createSchedule() { const params =
    this.forms.schedule.params ? JSON.parse(this.forms.schedule.params) : {};
    await this.callAPI('/api/schedules/create', { job: this.forms.schedule.job,
    rrule: this.forms.schedule.rrule, params }, 'schedule'); }, async
    sendNotification() { await this.callAPI('/api/notifications/send', {
    template_id: this.forms.notification.template_id, channels:
    this.forms.notification.channels }, 'notification'); }, async
    tagExperiment() { await this.callAPI('/api/experiments/tag', { run_id:
    this.forms.tag.run_id, tags: this.forms.tag.tags }, 'tag'); }, async
    cancelRun() { await this.callAPI('/api/runs/cancel', { run_id:
    this.forms.cancel.run_id, reason: this.forms.cancel.reason }, 'cancel'); },
