                            .sidebar {
                                order: 3;
                            }
                            .main-content {
                                order: 2;
                            }
                            .activity-panel {
                                order: 1;
                            }
                        }
                        .sidebar {
                            background: white;
                            border-radius: 12px;
                            padding: 20px;
                            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
                            height: fit-content;
                            position: sticky;
                            top: 20px;
                        }
                        .nav-menu {
                            list-style: none;
                        }
                        .nav-item {
                            padding: 12px 15px;
                            margin-bottom: 8px;
                            border-radius: 8px;
                            cursor: pointer;
                            transition: all 0.2s;
                            display: flex;
                            align-items: center;
                            gap: 10px;
                            font-weight: 500;
                        }
                        .nav-item:hover {
                            background: #f0f0f0;
                        }
                        .nav-item.active {
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            color: white;
                        }
                        .main-content {
                            background: white;
                            border-radius: 12px;
                            padding: 25px;
                            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
                        }
                        .section-title {
                            font-size: 1.5em;
                            font-weight: 700;
                            margin-bottom: 20px;
                            color: #333;
                            display: flex;
                            align-items: center;
                            gap: 10px;
                        }
                        .tool-grid {
                            display: grid;
                            grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
                            gap: 20px;
                        }
                        .tool-card {
                            background: #f8f9fa;
                            border-radius: 10px;
                            padding: 20px;
                            border: 2px solid transparent;
                            transition: all 0.3s;
                        }
                        .tool-card:hover {
                            border-color: #667eea;
                            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
                        }
                        .tool-header {
                            font-weight: 600;
                            font-size: 1.1em;
                            margin-bottom: 10px;
                            color: #667eea;
                        }
                        .tool-description {
                            font-size: 0.9em;
                            color: #666;
                            margin-bottom: 15px;
                        }
                        .form-group {
                            margin-bottom: 15px;
                        }
                        .form-label {
                            display: block;
                            font-size: 0.9em;
                            font-weight: 500;
                            margin-bottom: 5px;
                            color: #555;
                        }
                        .form-input,
                        .form-select,
                        .form-textarea {
                            width: 100%;
                            padding: 10px;
                            border: 1px solid #ddd;
                            border-radius: 6px;
                            font-size: 0.95em;
                            font-family: inherit;
                            transition: border-color 0.2s;
                        }
                        .form-input:focus,
                        .form-select:focus,
                        .form-textarea:focus {
                            outline: none;
                            border-color: #667eea;
                        }
                        .form-textarea {
                            resize: vertical;
                            min-height: 80px;
                            font-family: "Courier New", monospace;
                        }
                        .btn {
                            padding: 10px 20px;
                            border: none;
                            border-radius: 8px;
                            font-weight: 600;
                            cursor: pointer;
                            transition: opacity 0.2s;
                            font-size: 0.95em;
                        }
                        .btn:hover {
                            opacity: 0.9;
                        }
                        .btn:disabled {
                            opacity: 0.6;
                            cursor: not-allowed;
                        }
                        .btn-primary {
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            color: white;
                            width: 100%;
                        }
                        .btn-secondary {
                            background: #6c757d;
                            color: white;
                        }
                        .activity-panel {
                            background: white;
                            border-radius: 12px;
                            padding: 20px;
                            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
                            height: fit-content;
                            max-height: calc(100vh - 140px);
                            position: sticky;
                            top: 20px;
                            display: flex;
                            flex-direction: column;
                        }
                        .activity-header {
                            font-weight: 700;
                            font-size: 1.2em;
                            margin-bottom: 15px;
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                        }
                        .activity-feed {
                            overflow-y: auto;
                            flex: 1;
                        }
                        .activity-item {
                            padding: 12px;
                            margin-bottom: 10px;
                            border-radius: 8px;
                            background: #f8f9fa;
                            border-left: 4px solid #667eea;
                            animation: slideIn 0.3s ease-out;
                            font-size: 0.9em;
                        }
                        @keyframes slideIn {
                            from {
                                opacity: 0;
                                transform: translateX(-20px);
                            }
                            to {
                                opacity: 1;
                                transform: translateX(0);
                            }
                        }
                        .activity-item.success {
                            border-left-color: #28a745;
                        }
                        .activity-item.error {
                            border-left-color: #dc3545;
                        }
                        .activity-title {
                            font-weight: 600;
                            margin-bottom: 4px;
                        }
                        .activity-time {
                            font-size: 0.85em;
                            color: #999;
                        }
                        .activity-message {
                            color: #666;
                            margin-top: 5px;
                        }
                        .toast-container {
                            position: fixed;
                            top: 20px;
                            right: 20px;
                            z-index: 1000;
                            max-width: 400px;
                        }
                        .toast {
                            background: white;
                            padding: 15px 20px;
                            border-radius: 8px;
                            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
                            margin-bottom: 10px;
                            animation: slideInRight 0.3s ease-out;
                            border-left: 4px solid #667eea;
                        }
                        @keyframes slideInRight {
                            from {
                                opacity: 0;
                                transform: translateX(100px);
                            }
                            to {
                                opacity: 1;
                                transform: translateX(0);
                            }
                        }
                        .toast.success {
                            border-left-color: #28a745;
                        }
                        .toast.error {
                            border-left-color: #dc3545;
                        }
                        .toast-header {
                            font-weight: 600;
                            margin-bottom: 5px;
                        }
                        .loading {
                            display: inline-block;
                            width: 16px;
                            height: 16px;
                            border: 2px solid #f3f3f3;
                            border-top: 2px solid #667eea;
                            border-radius: 50%;
                            animation: spin 1s linear infinite;
                        }
                        @keyframes spin {
                            0% {
                                transform: rotate(0deg);
                            }
                            100% {
                                transform: rotate(360deg);
                            }
                        }
                        .badge {
                            padding: 4px 10px;
                            border-radius: 12px;
                            font-size: 0.75em;
                            font-weight: 600;
                        }
                        .badge-success {
                            background: #d4edda;
                            color: #155724;
                        }
                        .badge-info {
                            background: #d1ecf1;
                            color: #0c5460;
                        }
                        .empty-state {
                            text-align: center;
                            padding: 40px;
                            color: #999;
                        }
                        .scrollbar-thin::-webkit-scrollbar {
                            width: 6px;
                        }
                        .scrollbar-thin::-webkit-scrollbar-track {
                            background: #f1f1f1;
                            border-radius: 10px;
                        }
                        .scrollbar-thin::-webkit-scrollbar-thumb {
                            background: #888;
                            border-radius: 10px;
                        }
                        .result-box {
                            margin-top: 15px;
                            padding: 12px;
                            background: #e9ecef;
                            border-radius: 6px;
                            font-family: "Courier New", monospace;
                            font-size: 0.85em;
                            max-height: 200px;
                            overflow-y: auto;
                        }
                        .tag-input-container {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 8px;
                            padding: 8px;
                            border: 1px solid #ddd;
                            border-radius: 6px;
                            min-height: 45px;
                        }
                        .tag {
                            background: #667eea;
                            color: white;
                            padding: 4px 10px;
                            border-radius: 15px;
                            font-size: 0.85em;
                            display: flex;
                            align-items: center;
                            gap: 5px;
                        }
                        .tag-remove {
                            cursor: pointer;
                            font-weight: bold;
                        }
                        .tag-input {
                            border: none;
                            outline: none;
                            flex: 1;
                            min-width: 100px;
                            font-size: 0.95em;
                        }
        </style>
    </head>
    <body>
        <div id="app">
            <div class="container">
                <!-- Header -->
                <div class="header">
                    <h1>
                        <span>🚀</span>
                        Qlib Crypto Trading Platform
                    </h1>
                    <div
                        :class="['connection-status', connected ? 'connected' : 'disconnected']"
                    >
                        <div class="status-dot"></div>
                        {{ connected ? 'Connected' : 'Disconnected' }}
                    </div>
                </div>
                loadStats
                <!-- Main Layout -->
                <div class="main-layout">
                    <!-- Left Sidebar - Navigation -->
                    <div class="sidebar">
                        <ul class="nav-menu">
                            <li
                                v-for="category in categories"
                                :key="category.id"
                                :class="['nav-item', { active: activeCategory === category.id }]"
                                @click="activeCategory = category.id"
                            >
                                <span>{{ category.icon }}</span>
                                <span>{{ category.name }}</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Main Content - Tools -->
                    <div class="main-content">
                        <h2 class="section-title">
                            <span>{{ currentCategory.icon }}</span>
                            {{ currentCategory.name }}
                        </h2>

                        <div class="tool-grid">
                            <!-- Data Tools -->
                            <div
                                v-if="activeCategory === 'data'"
                                class="tool-card"
                            >
                                <div class="tool-header">
                                    📊 Get Market Quote
                                </div>
                                <div class="tool-description">
                                    Get real-time quote for a crypto symbol
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Symbol (e.g., BTC/USDT)</label
                                    >
                                    <input
                                        v-model="forms.quote.symbol"
                                        class="form-input"
                                        placeholder="BTC/USDT"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Provider (optional)</label
                                    >
                                    <select
                                        v-model="forms.quote.provider"
                                        class="form-select"
                                    >
                                        <option value="">Auto</option>
                                        <option value="binance">Binance</option>
                                        <option value="kraken">Kraken</option>
                                        <option value="coinbase">
                                            Coinbase
                                        </option>
                                    </select>
                                </div>
                                <button
                                    @click="getQuote"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Get Quote</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Loading...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.quote.result"
                                    class="result-box"
                                >
                                    {{ forms.quote.result }}
                                </div>
                            </div>

                            <div
                                v-if="activeCategory === 'data'"
                                class="tool-card"
                            >
                                <div class="tool-header">
                                    📈 Get Historical Data
                                </div>
                                <div class="tool-description">
                                    Download historical price data
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Symbol</label>
                                    <input
                                        v-model="forms.historical.symbol"
                                        class="form-input"
                                        placeholder="BTC/USDT"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Start Date</label>
                                    <input
                                        v-model="forms.historical.start_date"
                                        type="date"
                                        class="form-input"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">End Date</label>
                                    <input
                                        v-model="forms.historical.end_date"
                                        type="date"
                                        class="form-input"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Interval</label>
                                    <select
                                        v-model="forms.historical.interval"
                                        class="form-select"
                                    >
                                        <option value="1m">1 Minute</option>
                                        <option value="5m">5 Minutes</option>
                                        <option value="1h">1 Hour</option>
                                        <option value="1d">1 Day</option>
                                    </select>
                                </div>
                                <button
                                    @click="getHistorical"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading"
                                        >Get Historical Data</span
                                    >
                                    <span v-else
                                        ><span class="loading"></span>
                                        Loading...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.historical.result"
                                    class="result-box"
                                >
                                    {{ forms.historical.result }}
                                </div>
                            </div>

                            <div
                                v-if="activeCategory === 'data'"
                                class="tool-card"
                            >
                                <div class="tool-header">
                                    💾 Create Snapshot
                                </div>
                                <div class="tool-description">
                                    Build a point-in-time snapshot for a dataset
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Dataset Name</label
                                    >
                                    <input
                                        v-model="forms.snapshot.dataset"
                                        class="form-input"
                                        placeholder="crypto_daily"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Calendar Type</label
                                    >
                                    <select
                                        v-model="forms.snapshot.calendar"
                                        class="form-select"
                                    >
                                        <option value="crypto_daily">
                                            Crypto Daily
                                        </option>
                                        <option value="crypto_hourly">
                                            Crypto Hourly
                                        </option>
                                    </select>
                                </div>
                                <button
                                    @click="createSnapshot"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Create Snapshot</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Processing...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.snapshot.result"
                                    class="result-box"
                                >
                                    {{ forms.snapshot.result }}
                                </div>
                            </div>

                            <!-- Feature Tools -->
                            <div
                                v-if="activeCategory === 'features'"
                                class="tool-card"
                            >
                                <div class="tool-header">
                                    🔧 Create Feature Set
                                </div>
                                <div class="tool-description">
                                    Create Alpha158/360 or custom features
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Dataset Reference</label
                                    >
                                    <input
                                        v-model="forms.features.dataset_ref"
                                        class="form-input"
                                        placeholder="crypto_daily"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Handler</label>
                                    <select
                                        v-model="forms.features.handler"
                                        class="form-select"
                                    >
                                        <option value="Alpha158">
                                            Alpha158
                                        </option>
                                        <option value="Alpha360">
                                            Alpha360
                                        </option>
                                        <option value="CustomFeatures">
                                            Custom Features
                                        </option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Parameters (JSON, optional)</label
                                    >
                                    <textarea
                                        v-model="forms.features.params"
                                        class="form-textarea"
                                        placeholder='{"param1": "value1"}'
                                    ></textarea>
                                </div>
                                <button
                                    @click="createFeatures"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Create Features</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Creating...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.features.result"
                                    class="result-box"
                                >
                                    {{ forms.features.result }}
                                </div>
                            </div>

                            <!-- Model Tools -->
                            <div
                                v-if="activeCategory === 'models'"
                                class="tool-card"
                            >
                                <div class="tool-header">🤖 Train Model</div>
                                <div class="tool-description">
                                    Train a machine learning model
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Dataset Reference</label
                                    >
                                    <input
                                        v-model="forms.train.dataset_ref"
                                        class="form-input"
                                        placeholder="crypto_daily"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Feature Set Reference</label
                                    >
                                    <input
                                        v-model="forms.train.feature_set_ref"
                                        class="form-input"
                                        placeholder="alpha158"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Model Handler</label
                                    >
                                    <select
                                        v-model="forms.train.handler"
                                        class="form-select"
                                    >
                                        <option value="LGBModel">
                                            LightGBM
                                        </option>
                                        <option value="XGBModel">
                                            XGBoost
                                        </option>
                                        <option value="LSTMModel">LSTM</option>
                                        <option value="TransformerModel">
                                            Transformer
                                        </option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Model Parameters (JSON,
                                        optional)</label
                                    >
                                    <textarea
                                        v-model="forms.train.params"
                                        class="form-textarea"
                                        placeholder='{"n_estimators": 100}'
                                    ></textarea>
                                </div>
                                <button
                                    @click="trainModel"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Train Model</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Training...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.train.result"
                                    class="result-box"
                                >
                                    {{ forms.train.result }}
                                </div>
                            </div>

                            <div
                                v-if="activeCategory === 'models'"
                                class="tool-card"
                            >
                                <div class="tool-header">🧪 Run Experiment</div>
                                <div class="tool-description">
                                    Execute a complete experiment recipe
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Dataset</label>
                                    <input
                                        v-model="forms.experiment.dataset"
                                        class="form-input"
                                        placeholder="crypto_daily"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Recipe</label>
                                    <select
                                        v-model="forms.experiment.recipe"
                                        class="form-select"
                                    >
                                        <option value="lightgbm_alpha158">
                                            LightGBM + Alpha158
                                        </option>
                                        <option value="xgboost_alpha360">
                                            XGBoost + Alpha360
                                        </option>
                                        <option value="lstm_basic">
                                            LSTM Basic
                                        </option>
                                        <option value="transformer_advanced">
                                            Transformer Advanced
                                        </option>
                                        <option value="ensemble_voting">
                                            Ensemble Voting
                                        </option>
                                        <option value="ensemble_stacking">
                                            Ensemble Stacking
                                        </option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Transaction Costs</label
                                    >
                                    <select
                                        v-model="forms.experiment.costs"
                                        class="form-select"
                                    >
                                        <option value="low">Low (0.05%)</option>
                                        <option value="medium">
                                            Medium (0.1%)
                                        </option>
                                        <option value="high">
                                            High (0.2%)
                                        </option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Rebalance Frequency</label
                                    >
                                    <select
                                        v-model="forms.experiment.rebalance"
                                        class="form-select"
                                    >
                                        <option value="weekly">Weekly</option>
                                        <option value="monthly">Monthly</option>
                                    </select>
                                </div>
                                <button
                                    @click="runExperiment"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Run Experiment</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Running...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.experiment.result"
                                    class="result-box"
                                >
                                    {{ forms.experiment.result }}
                                </div>
                            </div>

                            <!-- Backtest Tools -->
                            <div
                                v-if="activeCategory === 'backtest'"
                                class="tool-card"
                            >
                                <div class="tool-header">📊 Run Backtest</div>
                                <div class="tool-description">
                                    Backtest a trained model
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Model ID</label>
                                    <input
                                        v-model="forms.backtest.model_id"
                                        class="form-input"
                                        placeholder="model_20240101_123456"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Dataset Reference</label
                                    >
                                    <input
                                        v-model="forms.backtest.dataset_ref"
                                        class="form-input"
                                        placeholder="crypto_daily"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Transaction Costs</label
                                    >
                                    <select
                                        v-model="forms.backtest.costs"
                                        class="form-select"
                                    >
                                        <option value="low">Low</option>
                                        <option value="medium">Medium</option>
                                        <option value="high">High</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Rebalance</label>
                                    <select
                                        v-model="forms.backtest.rebalance"
                                        class="form-select"
                                    >
                                        <option value="weekly">Weekly</option>
                                        <option value="monthly">Monthly</option>
                                    </select>
                                </div>
                                <button
                                    @click="runBacktest"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Run Backtest</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Running...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.backtest.result"
                                    class="result-box"
                                >
                                    {{ forms.backtest.result }}
                                </div>
                            </div>

                            <!-- Serving Tools -->
                            <div
                                v-if="activeCategory === 'serving'"
                                class="tool-card"
                            >
                                <div class="tool-header">
                                    🔮 Generate Predictions
                                </div>
                                <div class="tool-description">
                                    Generate today's predictions
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Model ID</label>
                                    <input
                                        v-model="forms.predict.model_id"
                                        class="form-input"
                                        placeholder="model_20240101_123456"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Dataset Reference</label
                                    >
                                    <input
                                        v-model="forms.predict.dataset_ref"
                                        class="form-input"
                                        placeholder="crypto_daily"
                                    />
                                </div>
                                <button
                                    @click="predictToday"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading"
                                        >Generate Predictions</span
                                    >
                                    <span v-else
                                        ><span class="loading"></span>
                                        Predicting...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.predict.result"
                                    class="result-box"
                                >
                                    {{ forms.predict.result }}
                                </div>
                            </div>

                            <div
                                v-if="activeCategory === 'serving'"
                                class="tool-card"
                            >
                                <div class="tool-header">
                                    📅 Create Schedule
                                </div>
                                <div class="tool-description">
                                    Schedule a recurring job
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Job Name</label>
                                    <select
                                        v-model="forms.schedule.job"
                                        class="form-select"
                                    >
                                        <option value="daily_prediction">
                                            Daily Prediction
                                        </option>
                                        <option value="data_update">
                                            Data Update
                                        </option>
                                        <option value="model_retrain">
                                            Model Retrain
                                        </option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >RRULE (recurrence rule)</label
                                    >
                                    <input
                                        v-model="forms.schedule.rrule"
                                        class="form-input"
                                        placeholder="FREQ=DAILY;BYHOUR=9"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Parameters (JSON, optional)</label
                                    >
                                    <textarea
                                        v-model="forms.schedule.params"
                                        class="form-textarea"
                                        placeholder="{}"
                                    ></textarea>
                                </div>
                                <button
                                    @click="createSchedule"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Create Schedule</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Creating...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.schedule.result"
                                    class="result-box"
                                >
                                    {{ forms.schedule.result }}
                                </div>
                            </div>

                            <div
                                v-if="activeCategory === 'serving'"
                                class="tool-card"
                            >
                                <div class="tool-header">
                                    🔔 Send Notification
                                </div>
                                <div class="tool-description">
                                    Send notifications via Teams/Email
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Template ID</label
                                    >
                                    <select
                                        v-model="forms.notification.template_id"
                                        class="form-select"
                                    >
                                        <option value="prediction_alert">
                                            Prediction Alert
                                        </option>
                                        <option value="backtest_complete">
                                            Backtest Complete
                                        </option>
                                        <option value="model_trained">
                                            Model Trained
                                        </option>
                                        <option value="error_alert">
                                            Error Alert
                                        </option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Channels</label>
                                    <div>
                                        <label
                                            ><input
                                                type="checkbox"
                                                value="teams"
                                                v-model="forms.notification.channels"
                                            />
                                            Teams</label
                                        >
                                        <label style="margin-left: 15px"
                                            ><input
                                                type="checkbox"
                                                value="email"
                                                v-model="forms.notification.channels"
                                            />
                                            Email</label
                                        >
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Payload (JSON, optional)</label
                                    >
                                    <textarea
                                        v-model="forms.notification.payload"
                                        class="form-textarea"
                                        placeholder="{}"
                                    ></textarea>
                                </div>
                                <button
                                    @click="sendNotification"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading"
                                        >Send Notification</span
                                    >
                                    <span v-else
                                        ><span class="loading"></span>
                                        Sending...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.notification.result"
                                    class="result-box"
                                >
                                    {{ forms.notification.result }}
                                </div>
                            </div>

                            <!-- Management Tools -->
                            <div
                                v-if="activeCategory === 'management'"
                                class="tool-card"
                            >
                                <div class="tool-header">🏷️ Tag Experiment</div>
                                <div class="tool-description">
                                    Assign lifecycle tags to runs
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Run ID</label>
                                    <input
                                        v-model="forms.tag.run_id"
                                        class="form-input"
                                        placeholder="run_123456"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Tags</label>
                                    <div>
                                        <label
                                            ><input
                                                type="checkbox"
                                                value="candidate"
                                                v-model="forms.tag.tags"
                                            />
                                            Candidate</label
                                        >
                                        <label style="margin-left: 15px"
                                            ><input
                                                type="checkbox"
                                                value="promoted"
                                                v-model="forms.tag.tags"
                                            />
                                            Promoted</label
                                        >
                                        <label style="margin-left: 15px"
                                            ><input
                                                type="checkbox"
                                                value="archived"
                                                v-model="forms.tag.tags"
                                            />
                                            Archived</label
                                        >
                                    </div>
                                </div>
                                <button
                                    @click="tagExperiment"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Tag Experiment</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Tagging...</span
                                    >
                                </button>
                                <div v-if="forms.tag.result" class="result-box">
                                    {{ forms.tag.result }}
                                </div>
                            </div>

                            <div
                                v-if="activeCategory === 'management'"
                                class="tool-card"
                            >
                                <div class="tool-header">❌ Cancel Run</div>
                                <div class="tool-description">
                                    Cancel a long-running job
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Run ID</label>
                                    <input
                                        v-model="forms.cancel.run_id"
                                        class="form-input"
                                        placeholder="run_123456"
                                    />
                                </div>
                                <div class="form-group">
                                    <label class="form-label"
                                        >Reason (optional)</label
                                    >
                                    <input
                                        v-model="forms.cancel.reason"
                                        class="form-input"
                                        placeholder="User requested cancellation"
                                    />
                                </div>
                                <button
                                    @click="cancelRun"
                                    class="btn btn-primary"
                                    :disabled="loading"
                                >
                                    <span v-if="!loading">Cancel Run</span>
                                    <span v-else
                                        ><span class="loading"></span>
                                        Cancelling...</span
                                    >
                                </button>
                                <div
                                    v-if="forms.cancel.result"
                                    class="result-box"
                                >
                                    {{ forms.cancel.result }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Panel - Activity Feed -->
                    <div class="activity-panel">
                        <div class="activity-header">
                            <span>🔔 Activity</span>
                            <span class="badge badge-info"
                                >{{ activities.length }}</span
                            >
                        </div>
                        <div class="activity-feed scrollbar-thin">
                            <div
                                v-if="activities.length === 0"
                                class="empty-state"
                            >
                                <p style="font-size: 0.9em">No activity yet</p>
                            </div>
                            <div
                                v-for="activity in activities.slice(0, 20)"
                                :key="activity.id"
                                :class="['activity-item', activity.class]"
                            >
                                <div class="activity-title">
                                    {{ activity.title }}
                                </div>
                                <div class="activity-message">
                                    {{ activity.message }}
                                </div>
                                <div class="activity-time">
                                    {{ formatTime(activity.timestamp) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Toast Notifications -->
            <div class="toast-container">
                <div
                    v-for="toast in toasts"
                    :key="toast.id"
                    :class="['toast', toast.level]"
                >
                    <div class="toast-header">{{ toast.title }}</div>
                    <div style="font-size: 0.9em; color: #666">
                        {{ toast.message }}
                    </div>
                </div>
            </div>
        </div>

        <script>
                        const { createApp } = Vue;

                        createApp({
                            data() {
                                return {
                                    connected: false,
                                    ws: null,
                                    loading: false,
                                    activeCategory: "data",
                                    categories: [
                                        { id: "data", name: "Data", icon: "📊" },
                                        { id: "features", name: "Features", icon: "🔧" },
                                        { id: "models", name: "Models", icon: "🤖" },
                                        { id: "backtest", name: "Backtest", icon: "📈" },
                                        { id: "serving", name: "Serving", icon: "🔮" },
                                        {
                                            id: "management",
                                            name: "Management",
                                            icon: "⚙️",
                                        },
                                    ],
                                    activities: [],
                                    toasts: [],
                                    nextActivityId: 1,
                                    nextToastId: 1,
                                    forms: {
                                        quote: {
                                            symbol: "BTC/USDT",
                                            provider: "",
                                            result: "",
                                        },
                                        historical: {
                                            symbol: "BTC/USDT",
                                            start_date: "2024-01-01",
                                            end_date: "2024-12-31",
                                            interval: "1d",
                                            result: "",
                                        },
                                        snapshot: {
                                            dataset: "crypto_daily",
                                            calendar: "crypto_daily",
                                            result: "",
                                        },
                                        features: {
                                            dataset_ref: "crypto_daily",
                                            handler: "Alpha158",
                                            params: "",
                                            result: "",
                                        },
                                        train: {
                                            dataset_ref: "crypto_daily",
                                            feature_set_ref: "alpha158",
                                            handler: "LGBModel",
                                            params: "",
                                            result: "",
                                        },
                                        experiment: {
                                            dataset: "crypto_daily",
                                            recipe: "lightgbm_alpha158",
                                            costs: "medium",
                                            rebalance: "weekly",
                                            result: "",
                                        },
                                        backtest: {
                                            model_id: "",
                                            dataset_ref: "crypto_daily",
                                            costs: "medium",
                                            rebalance: "weekly",
                                            result: "",
                                        },
                                        predict: {
                                            model_id: "",
                                            dataset_ref: "crypto_daily",
                                            result: "",
                                        },
                                        schedule: {
                                            job: "daily_prediction",
                                            rrule: "FREQ=DAILY;BYHOUR=9",
                                            params: "{}",
                                            result: "",
                                        },
                                        notification: {
                                            template_id: "prediction_alert",
                                            channels: [],
                                            payload: "{}",
                                            result: "",
                                        },
                                        tag: { run_id: "", tags: [], result: "" },
                                        cancel: { run_id: "", reason: "", result: "" },
                                    },
            WebSocketconnected                    };
                            },
                            computed: {
                                currentCategory() {
                                    return this.categories.find(
                                        (c) => c.id === this.activeCategory,
                                    );
                                },
                            },
                            mounted() {
                                this.connectWebSocket();
                            },
                            methods: {
                                connectWebSocket() {
                                    const protocol =
                                        window.location.protocol === "https:"
                                            ? "wss:"
                                            : "ws:";
                                    const wsUrl = `${protocol}//${window.location.host}/ws/events`;
                                    this.ws = new WebSocket(wsUrl);

                                    this.ws.onopen = () => {
                                        this.connected = true;
                                        this.addToast(
                                            "success",
                                            "Connected",
                                            "Real-time updates active",
                                        );
                                    };

                                    this.ws.onclose = () => {
                                        this.connected = false;
                                        setTimeout(() => this.connectWebSocket(), 3000);
                                    };

                                    this.ws.onmessage = (event) => {
                                        const data = JSON.parse(event.data);
                                        this.handleWebSocketMessage(data);
                                    };
                                },
                                handleWebSocketMessage(message) {
                                    if (message.type === "history") {
                                        message.events.forEach((event) =>
                                            this.handleEvent(event),
                                        );
                                    } else {
                                        this.handleEvent(message);
                                    }
                                },
                                handleEvent(event) {

                                    this.addActivity(
                                        title,
                                        message,
                                        event.timestamp,
                                        className,
                                    );
                                },
                                addActivity(title, message, timestamp, className = "info") {
                                    this.activities.unshift({
                                        id: this.nextActivityId++,
                                        title,
                                        message,
                                        timestamp: timestamp || new Date().toISOString(),
                                        class: className,
                                titlemessage  className                addActivity(title, message, timestamp, className = 'info') {
                                100                        });
                                    if (this.activities.length > 100) this.activities.pop();
                                },
                                addToast(level, title, message) {
                                    const toast = {
                                        id: this.nextToastId++,
                                        level,
                                        title,
                                        message,
                                    };
                                    this.toasts.push(toast);
                                    setTimeout(() => {
                                        const index = this.toasts.findIndex(
                                            (t) => t.id === toast.id,
                                        );
                                        if (index > -1) this.toasts.splice(index, 1);
                                    }, 5000);
                                },
                                async callAPI(endpoint, data, resultField) {
                                    this.loading = true;
                                    try {
                                        const response = await fetch(endpoint, {
                                            method: "POST",
                                            headers: { "Content-Type": "application/json" },
                                            body: JSON.stringify(data),
                                        });
                                        const result = await response.json();
                                        this.forms[resultField].result = JSON.stringify(
                                            result,
                                            null,
                                            2,
                                        );
                                        this.addToast(
                                            "success",
                                            "Success",
                                            `${resultField} completed`,
                                        );
                                        return result;
                                    } catch (error) {
                                        this.forms[resultField].result =
                                            `Error: ${error.message}`;
                                        this.addToast("error", "Error", error.message);
                                    } finally {
                                        this.loading = false;
                                    }
                                },
                                async getQuote() {
                                    await this.callAPI(
                                        "/api/market/quote",
                                        {
                                            symbol: this.forms.quote.symbol,
                                            provider: this.forms.quote.provider || null,
                                        },
                                        "quote",
                                    );
                                },
                                async getHistorical() {
                                    await this.callAPI(
                                        "/api/market/historical",
                                        {
                                            symbol: this.forms.historical.symbol,
                                            start_date: this.forms.historical.start_date,
                                            end_date: this.forms.historical.end_date,
                                            interval: this.forms.historical.interval,
                                        },
                                        "historical",
                                    );
                                },
                                async createSnapshot() {
                                    await this.callAPI(
                                        "/api/data/snapshot",
                                        {
                                            dataset: this.forms.snapshot.dataset,
                                            calendar: this.forms.snapshot.calendar,
                                        },
                                        "snapshot",
                                    );
                                },
                                async createFeatures() {
                                    const params = this.forms.features.params
                                        ? JSON.parse(this.forms.features.params)
                                        : {};
                                    await this.callAPI(
                                        "/api/features/create",
                                        {
                                            dataset_ref: this.forms.features.dataset_ref,
                                            handler: this.forms.features.handler,
                                            params,
                                        },
                                        "features",
                                    );
                                },
                                async trainModel() {
                                    const params = this.forms.train.params
                                        ? JSON.parse(this.forms.train.params)
                                        : {};
                                    await this.callAPI(
                                        "/api/models/train",
                                        {
                                            dataset_ref: this.forms.train.dataset_ref,
                                            feature_set_ref:
                                                this.forms.train.feature_set_ref,
                                            handler: this.forms.train.handler,
                                            params,
                                        },
                                        "train",
                                    );
                                },
                                async runExperiment() {
                                    await this.callAPI(
                                        "/api/experiments/run",
                                        {
                                            dataset: this.forms.experiment.dataset,
                                            recipe: this.forms.experiment.recipe,
                                            costs: this.forms.experiment.costs,
                                            rebalance: this.forms.experiment.rebalance,
                                        },
                                        "experiment",
                                    );
                                },
                                async runBacktest() {
                                    await this.callAPI(
                                        "/api/backtests/run",
                                        {
                                            model_id: this.forms.backtest.model_id,
                                            dataset_ref: this.forms.backtest.dataset_ref,
                                            costs: this.forms.backtest.costs,
                                            rebalance: this.forms.backtest.rebalance,
                                        },
                                        "backtest",
                                    );
                                },
                                async predictToday() {
                                    await this.callAPI(
                                        "/api/serving/predict",
                                        {
                                            model_id: this.forms.predict.model_id,
                                            dataset_ref: this.forms.predict.dataset_ref,
                                        },
                                        "predict",
                                    );
                                },
                                async createSchedule() {
                                    const params = this.forms.schedule.params
                                        ? JSON.parse(this.forms.schedule.params)
                                        : {};
                                    await this.callAPI(
                                        "/api/schedules/create",
                                        {
                                            job: this.forms.schedule.job,
                                            rrule: this.forms.schedule.rrule,
                                            params,
                                        },
                                        "schedule",
                                    );
                                },
                                async sendNotification() {
                                    const payload = this.forms.notification.payload
                                        ? JSON.parse(this.forms.notification.payload)
                                        : {};
                                    await this.callAPI(
                                        "/api/notifications/send",
                                        {
                                            template_id:
                                                this.forms.notification.template_id,
                                            channels: this.forms.notification.channels,
                                            payload,
                                        },
                                        "notification",
                                    );
                                },
                                async tagExperiment() {
                                    await this.callAPI(
                                        "/api/experiments/tag",
                                        {
                                            run_id: this.forms.tag.run_id,
                                            tags: this.forms.tag.tags,
                                        },
                                        "tag",
                                    );
                                },
                                async cancelRun() {
                                    await this.callAPI(
                                        "/api/runs/cancel",
                                        {
                                            run_id: this.forms.cancel.run_id,
                                            reason: this.forms.cancel.reason,
                                        },
                                        "cancel",
                                    );
                                },
                                formatTime(timestamp) {
                                    return new Date(timestamp).toLocaleTimeString();
                                },
                            },
                        }).mount("#app");
        </script>
    </body>
    callAPIendpoint, data, formKey this.loading = true; const response = await
    fetch(endpoint, { method: 'POST', headers: { 'Content-Type':
    'application/json' }, body: JSON.stringify(data) }); const result = await
