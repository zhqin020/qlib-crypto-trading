{
    "logging": {
        "level": "INFO",
        "log_file": "glib-crypto.log",
        "log_base": "glib-crypto",
        "max_index": 9
    },
    "data": {
        "interval": "1h",
        "exchange": "binance",
        "market_type": "future",
        "start_time": "2020-01-01",
        "end_time": "2025-12-25",
        "symbols": [
            "BTC/USDT",
            "ETH/USDT",
            "BNB/USDT",
            "SOL/USDT",
            "XRP/USDT",
            "ADA/USDT",
            "AVAX/USDT",
            "DOT/USDT",
            "LINK/USDT",
            "LTC/USDT",
            "PEPE/USDT",
            "SUI/USDT"
        ]
    },
    "backtest": {
        "start_time": "2023-05-03",
        "end_time": "2025-12-25",
        "topk": 5,
        "portfolios": [
            "BTC/USDT",
            "ETH/USDT",
            "BNB/USDT",
            "SOL/USDT",
            "XRP/USDT",
            "ADA/USDT",
            "AVAX/USDT",
            "DOT/USDT",
            "LINK/USDT",
            "LTC/USDT"
        ],
        "rebalance": "1h",
        "benchmark": "BTC"
    },
    "training": {
        "model_type": "xgboost",
        "feature_handler": "alpha158",
        "device": "auto",
        "models": {
            "lightgbm": {
                "loss": "mse",
                "colsample_bytree": 0.8879,
                "learning_rate": 0.01,
                "subsample": 0.8789,
                "lambda_l1": 0.01,
                "lambda_l2": 0.1,
                "max_depth": 8,
                "num_leaves": 15,
                "num_threads": 20
            },
            "xgboost": {
                "booster": "gbtree",
                "learning_rate": 0.01,
                "max_depth": 6,
                "n_estimators": 300,
                "objective": "reg:squarederror"
            },
            "lstm": {
                "d_feat": 158,
                "hidden_size": 64,
                "num_layers": 2,
                "dropout": 0.2,
                "n_epochs": 100,
                "lr": 0.001,
                "batch_size": 512,
                "early_stop": 20,
                "loss": "mse",
                "optimizer": "adam"
            }
        }
    }
}