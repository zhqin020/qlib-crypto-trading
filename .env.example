# Qlib Crypto Trading Platform Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=5100

# Database Configuration
DATABASE_URL=postgresql://qlib:qlib_password@postgres:5110/qlib_crypto

# Redis Configuration
REDIS_URL=redis://redis:5120/0

# Exchange API Keys (optional - for authenticated endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Qlib Configuration
QLIB_DATA_DIR=./data/qlib
QLIB_REGION=crypto

# Notification Configuration
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/qlib_crypto.log

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_NOTIFICATIONS=true
ENABLE_SCHEDULER=true

# WebSocket Security Configuration
# Comma-separated list of API keys for WebSocket authentication
# Generate keys using: python3 -c "from src.ui.security import generate_api_key; print(generate_api_key())"
WEBSOCKET_API_KEYS=qlib_dev_key_change_in_production

# WebSocket token configuration
WEBSOCKET_TOKEN_SECRET=change_me_in_production
WEBSOCKET_TOKEN_TTL_SECONDS=3600

# WebSocket limits (optional - defaults shown)
WS_MAX_MESSAGE_SIZE=1048576      # 1MB per message
WS_MAX_CONNECTIONS_PER_USER=10   # Max concurrent connections per user
WS_MAX_MESSAGES_PER_MINUTE=100   # Rate limit per connection
WS_HEARTBEAT_TIMEOUT=60          # Seconds before connection timeout

# Process monitor persistence (REQUIRED for multi-worker support)
PROCESS_MONITOR_REDIS_URL=redis://localhost:6379/1
PROCESS_MONITOR_REDIS_KEY=process_monitor:processes
PROCESS_MONITOR_CHANNEL=process_monitor:events

# Prediction safeguards
PREDICTION_MAX_DATA_AGE_HOURS=24

# Automated market data refresh (keeps prediction datasets current)
DATA_REFRESH_ENABLED=false
DATA_REFRESH_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT
DATA_REFRESH_INTERVAL=1d
DATA_REFRESH_LOOKBACK_DAYS=30
DATA_REFRESH_FREQUENCY_MINUTES=180
DATA_REFRESH_PROVIDER=binance
DATA_REFRESH_DATASET=crypto
DATA_REFRESH_CALENDAR=crypto_1d
DATA_REFRESH_OUTPUT_DIR=data/raw

# Workaround for pyqlib version resolution outside Git checkout
SETUPTOOLS_SCM_PRETEND_VERSION=0.9.8
