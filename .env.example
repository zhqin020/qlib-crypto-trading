# Qlib Crypto Trading Platform Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=5100

# Database Configuration
DATABASE_URL=postgresql://qlib:qlib_password@postgres:5110/qlib_crypto

# Redis Configuration
REDIS_URL=redis://redis:5120/0

# Exchange API Keys (optional - for authenticated endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Qlib Configuration
QLIB_DATA_DIR=./data/qlib
QLIB_REGION=crypto

# Notification Configuration
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/qlib_crypto.log

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_NOTIFICATIONS=true
ENABLE_SCHEDULER=true
